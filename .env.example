# Time clock — configuration for the Node runtime (`npm start`) and Docker Compose.
# Copy to `.env` and adjust. Variables already set in the environment take precedence over this file.
# (Cloudflare Workers uses wrangler.jsonc and .dev.vars / `wrangler secret put` instead.)

# Required. Signs session cookies: random string of at least 32 characters, e.g. `openssl rand -hex 32`.
# Changing it logs everyone out.
SESSION_SECRET=

# HTTP server (Node only). Docker: keep HOST=0.0.0.0 and change the published port in docker-compose.yml.
# PORT=3000
# HOST=0.0.0.0

# SQLite database file (Node only). Its folder is created if needed; migrations run at startup.
# Docker sets it to /data/time-clock-pointeuse.db (the volume). The accounts CLI (`npm run user`) uses it too.
DATABASE_PATH=./data/time-clock-pointeuse.db

# Instance defaults, applied until each user changes their own settings. Invalid values are ignored.
# Interface and webhook messages language: en | fr
# DEFAULT_LOCALE=en
# IANA time zone used to split days, e.g. Europe/Paris, America/Montreal
# DEFAULT_TIMEZONE=UTC
# Public holidays region code (e.g. FR, FR-AM, BE, CH), or none
# DEFAULT_HOLIDAYS=none
# Daily target in minutes (420 = 7h00)
# DEFAULT_DAILY_TARGET_MIN=420
