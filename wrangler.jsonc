{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opointeuse",
  "main": "server/entry/cloudflare.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Front end (built by Vite). Non-API requests are served directly; the binding lets the worker
    // fall back to it (server/app.ts).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opointeuse",
      // Replace with the id printed by `npx wrangler d1 create opointeuse`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
