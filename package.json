{
  "name": "opointeuse",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Self-hosted personal time clock: punch in/out via webhook, daily balance, leave and holidays. Runs on Cloudflare Workers + D1, Node or Docker.",
  "keywords": ["time-tracking", "time-clock", "timesheet", "cloudflare-workers", "d1", "hono", "self-hosted", "react"],
  "engines": { "node": ">=22.13" },
  "repository": { "type": "git", "url": "git+https://github.com/<owner>/opointeuse.git" },
  "homepage": "https://github.com/<owner>/opointeuse",
  "bugs": { "url": "https://github.com/<owner>/opointeuse/issues" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:node": "vite build --mode node && tsx server/node/build.ts",
    "start": "node dist/server/index.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply opointeuse --local",
    "db:migrate:remote": "wrangler d1 migrations apply opointeuse --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "echarts": "^6.1.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@cloudflare/workers-types": "^5.20260925.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
